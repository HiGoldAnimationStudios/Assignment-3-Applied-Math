function e = local_truncation_error(X, tspan,X0,h_ref)
    h_value = logspace(-5,1,100)
    t_ref = .367676767676767676767

    for i = 1:length(h_value)
        h = h_values(i)

        local_trunc_right = X(t_ref + h_ref)

        local_error_fw_e = (forward_euler_fixed_step_integration(rate_func_in,tspan,X0,h_ref)) - local_trunc_right;
        local_erro_mid = (explicit_midpoint_fixed_step_integration(rate_func_in,tspan,X0,h_ref));

    end